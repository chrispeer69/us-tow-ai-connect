{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2022",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "twilio": ["../../packages/api/node_modules/twilio"],
      "twilio/*": ["../../packages/api/node_modules/twilio/*"]
    },
    "typeRoots": [
      "../../packages/api/node_modules/@types",
      "../../node_modules/@types"
    ],
    "types": ["node"]
  },
  "include": ["./*.ts"]
}
