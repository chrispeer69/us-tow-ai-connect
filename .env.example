# =============================================================================
# US Tow AI-Connect — root env template
# =============================================================================
# The API and web app each maintain their own .env file. This root template
# only exists to point you at them.
#
#   packages/api/.env.example   -> copy to packages/api/.env
#   packages/web/.env.example   -> copy to packages/web/.env
#
# For the production deployment, every variable is set in Railway directly
# (per-service), NOT in any committed file. See docs/DEPLOY_RAILWAY.md.
# =============================================================================

# =============================================================================
# Session 41 — env vars found in code but NOT yet documented in the per-package
# templates. Listed here (root) because packages/** is out of scope for the
# secrets session. Authoritative inventory: docs/security/env-vars-inventory.txt.
# When a package-owning session next touches packages/api/.env.example, fold the
# relevant entries in there and trim this block. NEVER put real values here.
# =============================================================================

# ---- AAA portal credentials (dev selector-discovery script only) ------------
# Production AAA logins are stored ENCRYPTED per-tenant in tenant_credentials,
# not in env. These are read only by packages/api/scripts/discover-aaa-selectors.ts.
# AAA_USERNAME=
# AAA_PASSWORD=
# AAA_PORTAL_USERNAME=   # fallback names for the same script
# AAA_PORTAL_PASSWORD=

# ---- Secrets / signing ------------------------------------------------------
# Super-admin impersonation token signing secret. Generate: openssl rand -hex 32
# IMPERSONATION_SECRET=REPLACE_ME_IMPERSONATION_SECRET
# Shared API key for Thinkrr partner mode (paired with PARTNER_NAME).
# PARTNER_API_KEY=REPLACE_ME_PARTNER_API_KEY
# PARTNER_NAME=
# Tenant API keys for the driver app / demo tenant (generate-api-key script).
# DRIVER_TENANT_API_KEY=REPLACE_ME_DRIVER_TENANT_API_KEY
# NEXT_PUBLIC_DEMO_TENANT_API_KEY=REPLACE_ME_DEMO_TENANT_API_KEY
# Signup CAPTCHA provider secret + verify endpoint.
# SIGNUP_CAPTCHA_KEY=REPLACE_ME_CAPTCHA_KEY
# SIGNUP_CAPTCHA_VERIFY_URL=

# ---- Email / alerting addresses (not secrets) -------------------------------
# DIGEST_EMAIL_FROM=digest@ustowdispatch.com
# OPS_ALERT_EMAIL=ops@ustowdispatch.com
# SUPER_ADMIN_DEV_EMAIL=         # dev-only super-admin bootstrap email
# SUPPORT_PHONE=

# ---- URLs / config (not secrets) --------------------------------------------
# NEXT_INTERNAL_API_URL=         # server-to-server API origin for the web app
# TRACKING_URL_BASE=             # base for caller live-tracking links
# THINKRR_KP_REFRESH_WEBHOOK_URL=
# PROD_FILE_STORAGE=             # prod file-storage backend selector
# PLAYWRIGHT_BASE_URL=           # adapter/e2e target override
# TOWBOOK_DEBUG_DUMP=            # set to dump Towbook DOM for debugging (dev)
# =============================================================================
