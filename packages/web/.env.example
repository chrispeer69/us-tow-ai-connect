# =============================================================================
# @ustow/web environment variables
# =============================================================================
# Every NEXT_PUBLIC_* variable is baked into the client bundle at build time
# — set them in Railway (web service -> Settings -> Variables) BEFORE the
# first deploy. Changing them after the fact triggers a fresh build.
# =============================================================================

# Base URL the browser uses to reach the NestJS API. In prod this is the
# public API origin (custom domain or *.up.railway.app). The Next.js rewrite
# in next.config.js forwards /api/* to this host.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Socket.io endpoint used by the Command Center live updates. Shares the HTTP
# origin with NEXT_PUBLIC_API_URL by default — only override if you split the
# realtime gateway onto its own service later.
NEXT_PUBLIC_WS_URL=http://localhost:3001

# UUID of the tenant the admin dashboard loads when no other tenant context
# is provided. Tenant zero (Roadside Towing) seeds with this UUID.
NEXT_PUBLIC_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# Google Maps JS API key (browser-side). When unset the Command Center
# renders a placeholder asking the operator to configure the key.
# Keep this DIFFERENT from GOOGLE_PLACES_API_KEY on the API — restrict this
# key by HTTP referer (app.<domain>) in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Standard Next.js settings.
NODE_ENV=development
PORT=3000

# ---------- Sentry -----------------------------------------------------------
# Browser SDK DSN. Inlined into the client bundle at build time, so it must be
# set BEFORE the @ustow/web service first deploys (changing it later forces a
# rebuild). Leave blank to keep the client SDK inert.
NEXT_PUBLIC_SENTRY_DSN=
# Server + edge runtime DSN. Used by instrumentation.ts when the Next.js
# server boots. Typically the same project as the browser DSN.
SENTRY_DSN=
# Optional, for source-map upload in CI:
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# ---------- /inquire-shares form -----------------------------------------------
# Server action in src/app/inquire-shares/actions.ts sends submissions to
# chris@bluecollarai.online via SendGrid REST API. Without SENDGRID_API_KEY the
# action logs the payload server-side and shows the visitor a friendly fallback.
SENDGRID_API_KEY=
# Optional override for recipient. Defaults to chris@bluecollarai.online.
SHARES_INQUIRY_TO=
# Optional override for the from address. Defaults to chris@bluecollarai.online.
# IMPORTANT: must be a verified single sender (or part of an authenticated
# domain) in your SendGrid account or the API will reject with 403.
SHARES_INQUIRY_FROM=
