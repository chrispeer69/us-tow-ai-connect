{
  "name": "@ustow/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "pnpm --filter @ustow/shared build",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-api-key": "tsx src/bin/generate-api-key.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@sendgrid/mail": "^8.1.0",
    "bcrypt": "^5.1.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.30.0",
    "ioredis": "^5.3.0",
    "pg": "^8.11.0",
    "pino": "^8.0.0",
    "playwright": "^1.43.0",
    "zod": "^3.22.0",
    "rxjs": "^7.8.1",
    "reflect-metadata": "^0.2.2",
    "@ustow/shared": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.21.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  }
}
