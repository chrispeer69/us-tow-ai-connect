{
  "name": "@ustow/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "pnpm --filter @ustow/shared build",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-api-key": "tsx src/bin/generate-api-key.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:seed:tenant-zero": "tsx src/db/seeds/roadside-tenant-zero.ts",
    "db:seed:tenant-zero:prod": "node dist/db/seeds/roadside-tenant-zero.js",
    "db:seed:command-center": "tsx src/db/seeds/command-center-tenant-zero.ts",
    "db:seed:command-center:prod": "node dist/db/seeds/command-center-tenant-zero.js",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/websockets": "^10.4.22",
    "@sendgrid/mail": "^8.1.0",
    "@sentry/nestjs": "^10.54.0",
    "@sentry/node": "^7.119.0",
    "@sentry/profiling-node": "^10.54.0",
    "@ustow/shared": "workspace:*",
    "bcrypt": "^5.1.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.30.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.0",
    "jsonpath-plus": "^10.0.0",
    "pg": "^8.11.0",
    "pino": "^8.0.0",
    "playwright": "^1.43.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "stripe": "^22.1.1",
    "twilio": "^6.0.2",
    "web-push": "^3.6.7",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.21.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  }
}
