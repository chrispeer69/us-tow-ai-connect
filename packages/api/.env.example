# =============================================================================
# @ustow/api environment variables
# =============================================================================
# Every variable listed here must be set in Railway for the api service
# (Settings -> Variables). Local dev reads from packages/api/.env (which is
# gitignored). See docs/DEPLOY_RAILWAY.md section 3 for the production
# values + sources.
# =============================================================================

# ---------- Runtime ----------------------------------------------------------

# Node runtime environment. Values: development | production | test.
NODE_ENV=development

# Port the NestJS API listens on. Railway also sets PORT; either is honoured.
PORT=3001

# ---------- Data stores -------------------------------------------------------

# Postgres connection string. Local dev: Docker Postgres on port 5433 (see docker-compose.yml).
# Production: reference Railway plugin via ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgresql://ustow:ustow_dev@localhost:5433/ustow

# Redis connection string. Local dev: Docker Redis on port 6380.
# Production: reference Railway plugin via ${{Redis.REDIS_URL}}.
REDIS_URL=redis://localhost:6380

# ---------- URLs --------------------------------------------------------------

# Public base URL of this API. Used to build the per-tenant Knowledge Pack URL
# + Thinkrr/Twilio webhook URLs. In prod set to https://api.<domain>; in dev
# use the ngrok URL while Thinkrr/Twilio need to reach you.
PUBLIC_BASE_URL=http://localhost:3001

# Public origin of the admin web app, used for the CORS allow-list. In prod
# this is https://app.<domain> or the Railway-generated *.up.railway.app URL.
WEB_PUBLIC_URL=http://localhost:3000

# Comma-separated extra origins to allow through CORS (optional). Use for
# secondary preview deployments or in-house tooling.
# Example: https://staging.app.example.com,https://opsbot.internal
CORS_EXTRA_ORIGINS=

# Primary CORS allow-list (Session 46). Comma-separated origins. Supports a
# `scheme://*.suffix` wildcard for one subdomain label (e.g. Railway's
# generated hosts). When set, this is the source of truth; WEB_PUBLIC_URL +
# CORS_EXTRA_ORIGINS above are still merged in for back-compat. When BOTH this
# and the legacy vars are empty, the API falls back to localhost + Railway.
# Bringing a custom domain online = add it here, no code change. See
# docs/CUSTOM_DOMAIN.md.
# Example: https://app.ustow-aiconnect.com,https://api.ustow-aiconnect.com,https://*.up.railway.app
ALLOWED_DOMAINS=

# ---------- Secrets -----------------------------------------------------------

# 32-byte hex key (64 chars) used to encrypt per-tenant credentials at rest.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Signing secret used to verify the X-Webhook-Signature header on inbound
# Thinkrr webhooks. Generate: openssl rand -hex 32
THINKRR_WEBHOOK_SECRET=REPLACE_ME_THINKRR_WEBHOOK_SECRET

# JWT secret for the admin dashboard auth flow. Generate: openssl rand -hex 32
# Placeholder today — the admin flow currently relies on the x-tenant-id
# header (see docs/ASSUMPTIONS.md Session 5). Reserved so we don't ship a
# fresh secret-named variable later.
JWT_SECRET=REPLACE_ME_JWT_SECRET

# ---------- Provider credentials ----------------------------------------------

# Thinkrr.ai API key for managing tenant agents + Knowledge Packs.
# Get from thinkrr.ai -> Account -> API Keys.
THINKRR_API_KEY=REPLACE_ME_THINKRR_KEY

# Twilio account SID for outbound flip calls + CONVINI SMS.
# Get from console.twilio.com -> Account Info.
TWILIO_ACCOUNT_SID=REPLACE_ME_TWILIO_SID

# Twilio auth token paired with the SID above.
TWILIO_AUTH_TOKEN=REPLACE_ME_TWILIO_TOKEN

# E.164 phone number Twilio uses as the outbound caller ID.
TWILIO_PHONE_NUMBER=+15555555555

# Google Maps Places API key used by the outbound engine to discover nearby
# providers. Get from Google Cloud -> APIs & Services -> Credentials.
GOOGLE_PLACES_API_KEY=REPLACE_ME_GOOGLE_PLACES_KEY

# SendGrid API key for CONVINI email notifications. Leave blank to log alerts
# to stdout instead. Get from app.sendgrid.com -> Settings -> API Keys.
SENDGRID_API_KEY=
ALERT_EMAIL_FROM=alerts@ustowdispatch.com

# Sentry DSN for error reporting. Leave blank to disable Sentry (errors will
# fall back to Pino/console). Get from sentry.io -> Project Settings -> Client Keys.
SENTRY_DSN=

# Enables the operator smoke route GET /v1/admin/_debug/sentry-test, which
# throws a synthetic Error so you can verify Sentry capture end-to-end. Any
# value other than the literal string "true" returns 404. Leave unset in
# normal operation; flip to "true" for a one-shot verification, then unset.
# See docs/OBSERVABILITY.md.
SENTRY_DEBUG_ROUTE=

# ---------- Playwright --------------------------------------------------------

# Run Chromium headless. Set to false only for local debugging.
PLAYWRIGHT_HEADLESS=true

# Where the bundled browser lives inside the container. Matches the
# Dockerfile's COPY target — do not change unless the Dockerfile changes too.
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# ---------- Multi-tenant defaults --------------------------------------------

# Dev-only fallback tenant id used by the API when admin auth is bypassed.
DEFAULT_ADMIN_TENANT_ID=00000000-0000-0000-0000-000000000001

# ---------- Convini SMS integration (Session 25) ------------------------------

# Where the Convini partner publishes inbound job payloads. Pending from
# Chris — the receiver scaffolding accepts SMS bodies with a `CONVINI:` /
# `CONVINI#` marker; once the URL lands here a poller / pull-based fetcher
# can be added without changing the service surface. See
# docs/CONVINI_INTEGRATION.md for the placeholder wire format.
CONVINI_DOWNLOAD_URL=

# ---------- Web Push (Session 25) ---------------------------------------------

# VAPID keys for sending push notifications to driver PWAs. Generate with
# `npx web-push generate-vapid-keys`. Until both are set the API persists
# subscriptions but does not attempt delivery — see docs/ASSUMPTIONS.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@ustowdispatch.com

# ---------- Stripe credit billing (Session 28) -------------------------------

# Secret API key for the Stripe account. Use a test-mode key (sk_test_...) for
# tenant-zero / staging; live key (sk_live_...) only in prod. When unset the
# billing module boots in disabled mode — checkout/portal return 503, webhooks
# are refused. Set on Railway @ustow/api. See docs/sessions/S28_OPERATOR_TODO.md.
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_...) from the Stripe dashboard endpoint that
# points at ${PUBLIC_BASE_URL}/webhooks/stripe. Used to verify the
# stripe-signature header. Webhooks are rejected (503) until this is set.
STRIPE_WEBHOOK_SECRET=

# Stripe Price ids for the subscription tiers. Create products+prices in the
# Stripe dashboard (recurring/monthly) and paste the price_... ids here.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# One-off Price id for a per-job credit pack (mode=payment). Each purchase
# grants STRIPE_CREDIT_PACK_SIZE credits.
STRIPE_PRICE_CREDIT_PACK=

# Credits granted per credit-pack purchase. Default 100.
STRIPE_CREDIT_PACK_SIZE=100
