# Postgres connection string. Local dev: Docker Postgres on port 5433 (see docker-compose.yml).
DATABASE_URL=postgresql://ustow:ustow_dev@localhost:5433/ustow

# Redis connection string. Local dev: Docker Redis on port 6380 (see docker-compose.yml).
REDIS_URL=redis://localhost:6380

# 32-byte hex key (64 chars) used to encrypt per-tenant Towbook + Thinkrr credentials at rest. Generate: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Dev-only fallback tenant id used by the API when auth is bypassed (admin dashboard local mode).
DEFAULT_ADMIN_TENANT_ID=00000000-0000-0000-0000-000000000001

# SendGrid API key for CONVINI email notifications. Leave blank in dev to log to console. Get from app.sendgrid.com -> Settings -> API Keys.
SENDGRID_API_KEY=

# Sentry DSN for error reporting. Leave blank in dev. Get from sentry.io -> Project Settings -> Client Keys.
SENTRY_DSN=

# Node runtime environment. Values: development | production | test.
NODE_ENV=development

# Port the NestJS API listens on locally.
PORT=3001

# Thinkrr.ai API key for managing tenant agents + Knowledge Packs. Get from thinkrr.ai -> Account -> API Keys.
THINKRR_API_KEY=REPLACE_ME_THINKRR_KEY

# HMAC secret used to verify the X-Webhook-Signature header on inbound Thinkrr webhooks. Generate: openssl rand -hex 32
THINKRR_WEBHOOK_SECRET=REPLACE_ME_THINKRR_WEBHOOK_SECRET

# Twilio account SID for outbound flip calls + CONVINI SMS. Get from console.twilio.com -> Account Info.
TWILIO_ACCOUNT_SID=REPLACE_ME_TWILIO_SID

# Twilio auth token paired with the SID above. Get from console.twilio.com -> Account Info.
TWILIO_AUTH_TOKEN=REPLACE_ME_TWILIO_TOKEN

# E.164 phone number Twilio will use as the outbound caller ID. Provision in console.twilio.com -> Phone Numbers.
TWILIO_PHONE_NUMBER=+15555555555

# Google Maps Places API key used by the outbound engine to discover nearby providers. Get from console.cloud.google.com -> APIs & Services -> Credentials.
GOOGLE_PLACES_API_KEY=REPLACE_ME_GOOGLE_PLACES_KEY

# Public base URL of this API. Used to build the per-tenant Knowledge Pack URL + Thinkrr/Twilio webhook URLs. In prod set to https://api.yourdomain.com; in dev use ngrok if Thinkrr/Twilio need to reach you.
PUBLIC_BASE_URL=http://localhost:3001
